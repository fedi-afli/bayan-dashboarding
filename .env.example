# Copy to .env and adjust. Everything has a local-dev default.

# --- Postgres (docker-compose bayan_db) ---
POSTGRES_USER=bayan_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bayan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Identity provider (docker-compose bayan_auth = Keycloak) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
OIDC_ISSUER=http://localhost:8080/realms/bayan
OIDC_AUDIENCE=bayan-api

# --- URLs ---
FRONTEND_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:4200

# --- Credits & payments ---
WELCOME_CREDITS=3
# dev = simulated checkout page (local testing) | konnect
PAYMENT_PROVIDER=dev
KONNECT_API_BASE=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# --- Engine ---
MAX_UPLOAD_MB=50
